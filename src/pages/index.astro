---
import BaseLayout from '../layouts/BaseLayout.astro';
import AreaCard from '../components/AreaCard.astro';
import { getCollection } from 'astro:content';

const areas = await getCollection('areas');
const sortedAreas = areas.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));


---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content container">
      <h1>Vipava Valley Bouldering</h1>
      <p class="hero-tagline">A collection of boulders in the upper Vipava Valley, Slovenia</p>
    </div>
  </section>

  <!-- Map -->
  <section class="map-section container">
    <img
      src="/images/vv_boldermap.jpg"
      alt="Map of boulder areas in Vipava Valley"
      class="valley-map"
      loading="eager"
    />
  </section>

  <!-- Area Cards -->
  <section class="areas-section container">
    <h2>Boulder Areas</h2>
    <div class="areas-grid">
      {sortedAreas.map((area) => (
        <AreaCard area={area} />
      ))}
    </div>
  </section>

  <!-- Guidelines -->
  <section class="guidelines-section container">
    <div class="guidelines-card">
      <h2>Guidelines</h2>
      <p>Since we would like to continue bouldering in the area, please follow these guidelines:</p>
      <ul>
        <li>Respect the nature and rock, leave the place as it is, no littering.</li>
        <li>Park only in appropriate areas, don't block local paths. When in doubt, just don't.</li>
        <li>Don't come in big groups, no wild camping.</li>
      </ul>
    </div>
  </section>

  <!-- External Info -->
  <section class="external-section container">
    <h2>External Info</h2>
    <ul>
      <li>Guide to Hubelj bouldering in BETA magazine: <a href="https://issuu.com/betamag/docs/betamag">link</a></li>
      <li>Guide to Vitovlje bouldering: <a href="/Bouldering_Vitovlje_2012.pdf">PDF</a>, <a href="http://www.krimp.si/vitovlje/#1557066366465-fa5dc4c7-8b0f">web</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    color: #fff;
    padding: 3.5rem 0 3rem;
    text-align: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, var(--color-header-bg) 0%, #1a2e1c 50%, #2d3a2e 100%);
    z-index: 0;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 80%, rgba(61, 107, 79, 0.3) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgba(212, 133, 59, 0.15) 0%, transparent 50%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    color: #fff;
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .hero-tagline {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.05rem;
  }

  @media (min-width: 768px) {
    .hero {
      padding: 4.5rem 0 3.5rem;
    }
    .hero h1 {
      font-size: 2.75rem;
    }
    .hero-tagline {
      font-size: 1.25rem;
    }
  }

  /* Map */
  .map-section {
    margin-top: 2rem;
  }

  .valley-map {
    max-width: 600px;
    width: 100%;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  /* Areas */
  .areas-section {
    margin-top: 3rem;
  }

  .areas-section h2 {
    margin-bottom: 1.5rem;
  }

  .areas-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Guidelines */
  .guidelines-section {
    margin-top: 3rem;
  }

  .guidelines-card {
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-accent) 20%, var(--color-border));
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
  }

  .guidelines-card h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
  }

  .guidelines-card p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .guidelines-card ul {
    list-style: none;
    padding: 0;
  }

  .guidelines-card li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.375rem;
    line-height: 1.5;
    font-size: 0.9375rem;
  }

  .guidelines-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* External Info */
  .external-section {
    margin-top: 2rem;
  }

  .external-section h2 {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
  }

  .external-section ul {
    list-style: disc;
    padding-left: 1.5rem;
  }

  .external-section li {
    margin-bottom: 0.375rem;
    line-height: 1.5;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
</style>
